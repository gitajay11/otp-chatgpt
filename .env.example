# Copy to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────
# NODE_ENV is set by the npm scripts (`npm run dev` / `npm start`); don't set it here.
PORT=3000
HOST=127.0.0.1
APP_NAME=Orbit
# Public origin in production (used for the CSRF Origin check), e.g. https://app.example.com
APP_ORIGIN=
# Set when behind a reverse proxy: a hop count (1), "loopback", or a subnet list.
TRUST_PROXY=false
DATABASE_PATH=./data/app.db
LOG_LEVEL=info
# Defaults to true in production. Requires HTTPS.
COOKIE_SECURE=

# ── Secrets ──────────────────────────────────────────────
# Key for hashing OTPs at rest (required in production, at least 32 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=replace-with-a-long-random-secret

# ── SMTP (server-side only, never exposed to the browser) ─
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS (usually port 465); STARTTLS is required on other ports in production.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Orbit <no-reply@example.com>"

# ── Auth policy ──────────────────────────────────────────
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Require an email OTP after a correct password on every login.
LOGIN_OTP_REQUIRED=true
SESSION_TTL_DAYS=7

# ── Browser (only VITE_* variables reach the client bundle) ─
VITE_APP_NAME=Orbit
