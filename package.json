{
  "name": "orbit-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Sign up + login with 5-digit email OTP verification over SMTP.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "mail:dev": "node scripts/dev-smtp.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
